# IDEORA Environment Configuration
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# Supabase Public Client Credentials (safe for frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT SECURITY NOTE:
# - NEVER put Supabase service-role keys, database passwords, or private API keys here.
# - Only variables prefixed with VITE_ are exposed to the client bundle.
# - The service role key bypasses Row Level Security (RLS) and must ONLY be used in secure backend/serverless environments.
